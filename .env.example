# Supabase (login + saved progress).
# Supabase dashboard → Project Settings → API. Copy these into .env.local for
# running on your Mac, and into Vercel → Settings → Environment Variables.
# The anon key is designed to be public; access is controlled by supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Environment variables
GEMINI_API_KEY=
